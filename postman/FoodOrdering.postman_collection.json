{
  "info": { "name": "Food Ordering Microservices", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8080" }, { "key": "token", "value": "" }, { "key": "adminToken", "value": "" }, { "key": "orderId", "value": "" }],
  "item": [
    { "name": "Register customer", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/users/register", "body": { "mode": "raw", "raw": "{\"name\":\"Asha\",\"email\":\"asha@example.com\",\"password\":\"Password1\",\"phone\":\"9999999999\",\"role\":\"ADMIN\"}" } } },
    { "name": "Login customer", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/auth/login", "body": { "mode": "raw", "raw": "{\"email\":\"asha@example.com\",\"password\":\"Password1\"}" } }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Customer login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('token', pm.response.json().token);"] } }] },
    { "name": "Login seeded admin", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/auth/login", "body": { "mode": "raw", "raw": "{\"email\":\"admin@food.com\",\"password\":\"Admin@123\"}" } }, "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('adminToken', pm.response.json().token);"] } }] },
    { "name": "Food cache check", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{baseUrl}}/foods/1" } },
    { "name": "Admin view all food", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{adminToken}}"}], "url": "{{baseUrl}}/foods?all=true" } },
    { "name": "Create food as admin", "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/foods", "body": { "mode": "raw", "raw": "{\"name\":\"Demo Salad\",\"description\":\"Fresh seasonal salad\",\"price\":149.00,\"category\":\"STARTER\",\"restaurantId\":1,\"available\":true}" } } },
    { "name": "Place successful order", "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/orders", "body": { "mode": "raw", "raw": "{\"restaurantId\":1,\"items\":[{\"foodId\":1,\"quantity\":2}],\"paymentMethod\":\"CARD\"}" } }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Order is placed', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('orderId', pm.response.json().id);"] } }] },
    { "name": "Get my orders", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{baseUrl}}/orders?page=0&size=20" } },
    { "name": "Get payment", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{baseUrl}}/payments/{{orderId}}" } },
    { "name": "Admin notifications", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{adminToken}}"}], "url": "{{baseUrl}}/notifications" } },
    { "name": "Place failed order", "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/orders", "body": { "mode": "raw", "raw": "{\"restaurantId\":1,\"items\":[{\"foodId\":1,\"quantity\":1}],\"simulateFailure\":true}" } }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Payment failure maps to 402', () => pm.response.to.have.status(402));"] } }] }
  ]
}
